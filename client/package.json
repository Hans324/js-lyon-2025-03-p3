{
  "name": "projet-hans",
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "check-types:server": "tsc -p tsconfig.server.json --noEmit",
    "dev": "vite --host",
    "dev:server": "tsx watch main.ts",
    "dev:all": "concurrently -k \"npm run dev\" \"npm run dev:server\"",
    "docker:db": "docker compose up -d",
    "setup:upload": "node scripts/populate-upload.mjs",
    "setup": "npm run setup:upload && npm run docker:db",
    "start": "tsx main.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --verbose"
  },
  "dependencies": {
    "@stripe/stripe-js": "^7.6.1",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.4.1",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.4",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.4"
  }
}
